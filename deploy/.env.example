SCHEDULER_IMAGE=scheduler-saas:phase1
SCHEDULER_ORGANIZATION_SLUG=current-school
SCHEDULER_ORGANIZATION_NAME=示例学校
SCHEDULER_PORT=8765

# 首次启动会创建管理员；后续启动仅在声明值变化时更新并撤销旧会话。
SCHEDULER_BOOTSTRAP_USERNAME=admin
SCHEDULER_BOOTSTRAP_DISPLAY_NAME=教务管理员
# 相对于 deploy/compose.yaml 所在目录。文件只含密码正文，不要提交到 Git。
SCHEDULER_ADMIN_PASSWORD_FILE=./secrets/admin_password

# 生产环境请用密码管理器生成至少 32 字节随机值。
SCHEDULER_LOGIN_RATE_LIMIT_SECRET=replace-with-a-long-random-secret
SCHEDULER_SESSION_TTL_SECONDS=28800
SCHEDULER_MAX_JSON_BYTES=1048576
SCHEDULER_AI_ENFORCE_PUBLIC_NETWORK=true
# 可选：逗号分隔精确主机名；私网模型必须在这里显式允许。
SCHEDULER_AI_ALLOWED_HOSTS=
# 高级会员能力开关。计费系统接入后应由服务端订阅权益同步该值。
SCHEDULER_CONVERSATIONAL_SCHEDULING_ENABLED=false

# 本地 HTTP 请配合 compose.local.yaml；生产反代必须保持下面三项。
SCHEDULER_COOKIE_SECURE=true
SCHEDULER_ALLOW_INSECURE_HTTP=false
SCHEDULER_ENABLE_HSTS=true
SCHEDULER_TRUST_PROXY_HEADERS=true

SCHEDULER_WEB_MEMORY=1g
SCHEDULER_WEB_CPUS=1.0
SCHEDULER_WORKER_MEMORY=4g
SCHEDULER_WORKER_CPUS=4.0

# 仅服务端读取。浏览器和数据库配置只保存变量名 DOMESTIC_AI_API_KEY。
DOMESTIC_AI_API_KEY=

# 启用 tls profile 时使用。
SCHEDULER_DOMAIN=scheduler.example.cn
CADDY_EMAIL=ops@example.cn
